@{
    Rules = @{
        PSPlaceOpenBrace = @{
            Enable = $true
            IgnoreOneLineBlock = $false
        }

        PSPlaceCloseBrace = @{
            Enable = $true
            NewLineAfter = $false
            IgnoreOneLineBlock = $false
        }

        PSUseConsistentIndentation = @{
            Enable = $true
        }

        PSUseConsistentWhitespace = @{
            Enable = $true
        }

        PSUseCorrectCasing = @{
            Enable = $true
        }

        PSAvoidLongLines = @{
            Enable = $true
        }
    }
}
